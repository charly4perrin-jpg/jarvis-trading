APP_ENV=paper
QUOTE_CURRENCY=EUR
MIN_QUOTE_VOLUME_24H=50000
MAX_SPREAD_BPS=40
PAPER_STARTING_CASH=3000
PAPER_FEE_RATE=0.0025
PAPER_SLIPPAGE_BPS=10
RISK_PER_TRADE_PCT=0.005
MAX_DAILY_LOSS_PCT=0.02
MAX_WEEKLY_LOSS_PCT=0.05
MAX_TOTAL_EXPOSURE_PCT=0.60
MIN_CASH_RESERVE_PCT=0.40
MAX_OPEN_POSITIONS=5
AUDIT_LOG_PATH=./data/audit.jsonl
PAPER_LEDGER_PATH=./data/paper_ledger.jsonl
PAPER_STATE_PATH=./data/paper_state.json
EVENT_LOG_PATH=./data/events.jsonl
MAX_CONSECUTIVE_LOSSES=3
HALT_FLAG_PATH=./data/HALT
PAPER_MAX_SLIPPAGE_BPS=50
STRATEGY=momentum_demo
NOTIFY_MACOS=true
NOTIFY_DAILY_SUMMARY=true

# Grok (API officielle xAI) : avis en langage clair, jamais de décision.
# Créez la clé sur https://console.x.ai puis collez-la ici. Ne la partagez jamais.
XAI_API_KEY=
XAI_MODEL=grok-4.7
AI_MAX_CALLS_PER_DAY=40

# ChatGPT (API officielle OpenAI) : avis en langage clair, jamais de décision.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
AI_PROVIDER=auto

# Alertes par e-mail (optionnel) : adresse, compte d envoi et mot de passe d application.
NOTIFY_EMAIL_TO=
SMTP_USER=
SMTP_PASSWORD=
